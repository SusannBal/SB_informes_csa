# Copiá este archivo a ".env" y completá los dos valores de tu proyecto de
# Supabase (Project Settings → API). Sólo se usan para la pantalla de acceso
# (cuenta de prueba compartida) — el generador de informes en sí no toca
# Supabase para nada más, no hay tablas ni datos que se suban.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_PUBLICABLE
